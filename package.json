{
  "name": "the-narrator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "setup:voice": "node scripts/download-kokoro.mjs",
    "check:local": "tsx scripts/check-local.ts",
    "check:browser": "tsx scripts/check-browser.ts",
    "check:twitch": "tsx scripts/check-twitch.ts",
    "demo:capture": "tsx scripts/capture-demo.ts",
    "screens": "tsx scripts/screens.ts",
    "check:review": "tsx scripts/check-review.ts",
    "check:replay-offline": "tsx scripts/check-replay-offline.ts"
  },
  "dependencies": {
    "kokoro-js": "^1.2.1",
    "openai": "^7.47.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "playwright": "1.62.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
